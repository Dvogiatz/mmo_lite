<div id="game-root">
  <div id="canvas-column">
    <div id="floor-header">Floor <span id="floor-value">0</span></div>
    <canvas id="game-canvas" width="650" height="650"></canvas>

    <div id="joystick" aria-hidden="true">
      <span class="joystick-arrow" data-arrow="up">▲</span>
      <span class="joystick-arrow" data-arrow="right">▶</span>
      <span class="joystick-arrow" data-arrow="down">▼</span>
      <span class="joystick-arrow" data-arrow="left">◀</span>
      <span class="joystick-knob"></span>
    </div>
    <p id="touch-hint">Touch and drag anywhere on the map to move</p>
  </div>

  <div id="side-panel">
    <div id="player-name-badge"></div>

    <div class="panel-box">
      <h3>Hearts</h3>
      <div id="hearts"></div>
      <div id="hearts-count"></div>
    </div>

    <div class="panel-box">
      <h3>Level</h3>
      <div id="level-xp">
        <span id="level-value">Lv. 1</span>
        <span
          id="xp-value"
          title="Total XP earned — a lifetime counter, not a bar to fill. Killing a monster grants a level directly (more for a much higher-level monster); XP doesn't gate that."
        >
          0 XP
        </span>
      </div>
      <div
        id="power-value"
        title="Your attack power: level + equipment damage + active buff. Compare this to a monster's level before engaging it — a tie still goes to the 1d6 roll, it's not an automatic win."
      >
        Power: 1
      </div>
      <div
        id="odds-legend"
        title="Numbers above monsters are their power (level + armor), coloured by your odds of beating them right now."
      >
        <span class="odds sure">win</span>
        <span class="odds even">5 in 6</span>
        <span class="odds risky">1 in 6</span>
      </div>
    </div>

    <div id="buff-indicator" class="panel-box">
      <span>⚔️ Killing Spree</span>
      <span id="buff-timer"></span>
    </div>

    <div class="panel-box">
      <h3>Best equipment</h3>
      <ul id="equipment-list"></ul>
      <div
        id="gear-total"
        title="Every item you've looted adds its damage to your power — the list only shows the best few."
      >
      </div>
    </div>

    <div class="panel-box">
      <h3>Log</h3>
      <ul id="combat-log"></ul>
    </div>

    <div class="panel-box" id="chat-panel-placeholder">
      Chat coming in v2
    </div>
  </div>

  <button type="button" id="door-prompt"></button>

  <div id="name-overlay" class="hidden">
    <div id="name-card">
      <h2>Enter the maze</h2>
      <input
        id="name-input"
        type="text"
        maxlength="20"
        placeholder="Your name"
        autocomplete="off"
      />
      <button id="name-submit">Play</button>
    </div>
  </div>
</div>
