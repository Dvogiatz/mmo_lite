<div id="game-root">
  <div id="canvas-column">
    <div id="floor-header">Floor <span id="floor-value">0</span></div>
    <div id="map-wrap">
      <canvas id="game-canvas" width="650" height="650"></canvas>
      <div id="swipe-arrow" aria-hidden="true">▲</div>
      <button type="button" id="door-prompt"></button>
    </div>
    <p id="touch-hint">Swipe on the map to take a step</p>
  </div>

  <div id="side-panel">
    <div id="player-name-badge"></div>

    <div class="panel-box">
      <h3>Hearts</h3>
      <div id="hearts"></div>
      <div id="hearts-count"></div>
    </div>

    <div class="panel-box">
      <h3>Level</h3>
      <div id="level-xp">
        <span id="level-value">Lv. 1</span>
      </div>
      <div
        id="power-value"
        title="Your attack power: level + weapon damage + active buff. Compare this to a monster's level before engaging it — a tie still goes to the 1d6 roll, it's not an automatic win."
      >
        Power: 1
      </div>
      <div
        id="odds-legend"
        title="Numbers above monsters are their power (level + armor), coloured by your odds of beating them right now."
      >
        <span class="odds sure">win</span>
        <span class="odds even">5 in 6</span>
        <span class="odds risky">1 in 6</span>
      </div>
    </div>

    <div id="buff-indicator" class="panel-box">
      <span>⚔️ Killing Spree</span>
      <span id="buff-timer"></span>
    </div>

    <div
      id="evasion-indicator"
      class="panel-box"
      title="Just fled — combat is skipped entirely while this lasts, so you can walk straight through whatever blocked you."
    >
      <span>👻 Evasive</span>
      <span id="evasion-timer"></span>
    </div>

    <div class="panel-box">
      <h3>Equipment</h3>
      <div
        id="equipment-slots"
        title="One item per slot — a new drop only replaces what's equipped if it's strictly better."
      >
        <div class="slot-row">
          <span class="slot-label">Weapon</span><span id="weapon-slot">(empty)</span>
        </div>
        <div class="slot-row">
          <span class="slot-label">Armor</span><span id="armor-slot">(empty)</span>
        </div>
        <div class="slot-row">
          <span class="slot-label">Boots</span><span id="boots-slot">(empty)</span>
        </div>
      </div>
    </div>

    <div class="panel-box">
      <h3>On this floor <span id="roster-count"></span></h3>
      <ul
        id="floor-roster"
        title="Everyone on this floor and their level. Power (level + weapon + buff) only shows for players in sight."
      >
      </ul>
    </div>

    <div class="panel-box">
      <h3>Log</h3>
      <ul id="combat-log"></ul>
    </div>

    <div class="panel-box" id="chat-panel-placeholder">
      Chat coming in v2
    </div>
  </div>

  <div id="name-overlay" class="hidden">
    <div id="name-card">
      <h2>Enter the maze</h2>
      <input
        id="name-input"
        type="text"
        maxlength="20"
        placeholder="Your name"
        autocomplete="off"
      />
      <button id="name-submit">Play</button>
    </div>
  </div>
</div>
